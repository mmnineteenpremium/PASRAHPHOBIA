            <string name="Name">EventAssignment</string>
          </Properties>
        </Item>
        <Item class="Folder" referent="2587">
          <Properties>
            <string name="Name">EventEffects</string>
          </Properties>
        </Item>
        <Item class="Folder" referent="2588">
          <Properties>
            <string name="Name">EventEngine</string>
          </Properties>
        </Item>
        <Item class="Folder" referent="2589">
          <Properties>
            <string name="Name">EventRegistry</string>
