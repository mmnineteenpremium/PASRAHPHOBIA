    nextTradeId = 1,
    globalStats = {
        investigationsCompleted = {},
        survivalStreak = {},
        fastestIdentifySeconds = {},
    },
}

local function deepCopy(value)
    if type(value) ~= "table" then
        return value
    end
    local out = {}
