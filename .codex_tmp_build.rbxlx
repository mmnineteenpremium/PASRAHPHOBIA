          <Properties>
            <string name="Name">Integrations</string>
          </Properties>
          <Item class="ModuleScript" referent="2108">
            <Properties>
              <string name="Name">Controller</string>
              <string name="Source"><![CDATA[local Controller = {}
Controller.__index = Controller

function Controller.new(state, service, deps)
    local self = setmetatable({}, Controller)
    self._state = state
    self._service = service
    self._deps = deps or {}
    return self
end

function Controller:Init()
    -- Integrations will be stitched in once dependencies are wired.
end

return Controller
]]></string>
