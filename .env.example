# Copy this file to .env and fill in your real API keys. Do NOT commit .env
# The repo test script and Claude Code helper use OLOGON_API_KEY_1/2.
OLOGON_API_KEY_1=REPLACE_WITH_YOUR_FIRST_OLAGON_API_KEY
OLOGON_API_KEY_2=REPLACE_WITH_YOUR_SECOND_OLAGON_API_KEY
ANTHROPIC_API_BASE=https://gateway.olagon.site/anthropic/v1

# KoboiLLM is OpenAI-compatible. Fill this after creating a KoboiLLM virtual key.
KOBOILLM_API_KEY=nope
KOBOILLM_BASE_URL=https://api.koboillm.com/v1
w