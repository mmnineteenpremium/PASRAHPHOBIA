      "name": "FlashlightToggleVisualController",
      "className": "LocalScript",
      "properties": {
        "ScriptGuid": "{FD5A1468-224F-4A10-A472-96281394058A}",
        "Source": "local screenGui = script.Parent\nif not screenGui or not screenGui:IsA(\"ScreenGui\") then\n\treturn\nend\n\nlocal button = screenGui:FindFirstChild(\"ToggleButton\")\nif not button or not button:IsA(\"TextButton\") then\n\treturn\nend\n\nlocal states = {\n\tidle = \"106996620986201\",\n\thover = \"128353838297791\",\n\tactive = \"75271688724464\",\n}\n\nlocal function toImageAsset(assetId)\n\treturn string.format(\"rbxassetid://%s\", tostring(assetId))\nend\n\nlocal image = button:FindFirstChild(\"BrandTextImage\")\nif not image or not image:IsA(\"ImageButton\") then\n\tif image and (image:IsA(\"ImageLabel\") or image:IsA(\"ImageButton\")) then\n\t\timage:Destroy()\n\tend\n\timage = Instance.new(\"ImageButton\")\n\timage.Name = \"BrandTextImage\"\n\timage.BackgroundTransparency = 1\n\timage.AutoButtonColor = false\n\timage.Active = false\n\timage.Selectable = false\n\timage.Size = UDim2.new(1, -8, 1, -8)\n\timage.Position = UDim2.fromOffset(4, 4)\n\timage.ScaleType = Enum.ScaleType.Fit\n\timage.ZIndex = button.ZIndex + 1\n\timage.Parent = button\nend\nimage.HoverImage = toImageAsset(states.hover)\nimage.PressedImage = toImageAsset(states.active)\n\nlocal function apply(stateName)\n\timage.Image = toImageAsset(states[stateName] or states.idle)\n\tbutton.TextTransparency = 1\nend\n\napply(\"idle\")\nbutton.MouseEnter:Connect(function()\n\tapply(\"hover\")\nend)\nbutton.MouseLeave:Connect(function()\n\tapply(\"idle\")\nend)\nbutton.MouseButton1Down:Connect(function()\n\tapply(\"active\")\nend)\nbutton.MouseButton1Up:Connect(function()\n\tapply(\"hover\")\nend)\n"
      }
    }
