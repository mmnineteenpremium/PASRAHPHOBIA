						<UniqueId name="UniqueId">536cc62b1ebe128e09c1077b0000911a</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1B29EC0BCAC84B23934F1CC7ABDE24C8">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local State = {}
State.__index = State

local DEFAULT_STATE = {
    hiddenPlayers = {},
    detectedPlayers = {},
    activeMatchId = nil,
}

local function deepCopy(value)
    if type(value) ~= "table" then return value end
    local out = {}
    for key, nested in pairs(value) do out[key] = deepCopy(nested) end
    return out
end

function State.new()
    local self = setmetatable({}, State)
    self._data = deepCopy(DEFAULT_STATE)
    return self
end
function State:Get(key) return self._data[key] end
function State:Set(key, value) self._data[key] = value end
function State:Clear() self._data = deepCopy(DEFAULT_STATE) end
return State
]]></ProtectedString>
