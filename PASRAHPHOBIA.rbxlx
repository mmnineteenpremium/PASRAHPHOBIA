			<Item class="ModuleScript" referent="RBXD8B47A5C4204409BB7073BFE83BD45BA">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RoomManager = require(script.Parent:WaitForChild("Rooms"):WaitForChild("RoomManager"))
local MatchQueue = require(script.Parent.Parent:WaitForChild("MatchSystem"):WaitForChild("MatchQueue"))

local Players = game:GetService("Players")

local Service = {}
Service.__index = Service

function Service.new(state, deps)

	local self = setmetatable({}, Service)

	self._state = state
	self._deps = deps or {}

	self.RoomManager = RoomManager.new()
	self.Queue = MatchQueue.new()

	return self

end

function Service:Init()

	print("[LobbySystem] Service Init")

	self._state:Set("initialized", true)

end

function Service:Start()

	print("[LobbySystem] Service Start")

	local rooms = self.RoomManager:GetRooms()

	print("[LobbySystem] Rooms Initialized:", #rooms)

	-- DEBUG MATCH TEST
	task.delay(5,function()

		local players = Players:GetPlayers()

		if #players == 0 then
			print("[LobbySystem] No players for test match")
			return
		end

		print("[LobbySystem] DEBUG MATCH START")

		for _,player in ipairs(players) do

			local room = self.RoomManager:AddPlayerToRoom(player)

			if room then
				print(player.Name.." assigned to ROOM "..room.id)
			end

		end

	end)

	self._state:Set("started", true)

end

function Service:Stop()

	print("[LobbySystem] Service Stop")

	self._state:Set("started", false)

end

return Service
]]></ProtectedString>
