					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Service = require(script.Parent.Service)
local Controller = require(script.Parent.Controller)
local State = require(script.Parent.State)

local RuntimeMetricsSystem = {}
RuntimeMetricsSystem.__index = RuntimeMetricsSystem

local function getRegistry(deps)
    if type(deps) ~= "table" then
        return nil
    end
    return deps.Services or deps.ServiceRegistry
end

local function hasService(registry, name)
    if type(registry) ~= "table" then
        return false
    end
    if type(registry.GetService) == "function" then
        return registry:GetService(name) ~= nil
    end
    if type(registry.Get) == "function" then
        return registry:Get(name) ~= nil
    end
    if type(registry.HasService) == "function" then
        return registry:HasService(name)
    end
    if type(registry.Has) == "function" then
        return registry:Has(name)
    end
    return false
end

local function registerService(registry, name, service)
    if type(registry) ~= "table" then
        return false
    end
    if type(registry.RegisterService) == "function" then
        return registry:RegisterService(name, service)
    end
    if type(registry.Register) == "function" then
        return registry:Register(name, service)
    end
    return false
end

function RuntimeMetricsSystem.new(deps)
    local self = setmetatable({}, RuntimeMetricsSystem)
    self._deps = deps or {}
    self._created = false
    self.State = State.new(self._deps.RuntimeMetricsSystemState)
    self.Service = Service.new(self.State, self._deps)
    self.Controller = Controller.new(self.State, self.Service, self._deps)
    return self
end


function RuntimeMetricsSystem.Create(deps)
    local instance = RuntimeMetricsSystem.new(deps)
    instance:Initialize()
    return instance
end
function RuntimeMetricsSystem:Initialize()
    if self._created then
        return
    end
    self._created = true
    if type(self.Service.Create) == "function" then
        self.Service:Create()
    end
    if type(self.Controller.Create) == "function" then
        self.Controller:Create()
    end
    local registry = getRegistry(self._deps)
    if registry and not hasService(registry, "RuntimeMetricsSystem") then
        registerService(registry, "RuntimeMetricsSystem", self)
    end
end

function RuntimeMetricsSystem:Init()
    self:Initialize()
    self.Service:Init()
    self.Controller:Init()
end

function RuntimeMetricsSystem:Start()
    if type(self.Controller.Start) == "function" then
        self.Controller:Start()
    else
        self.Controller:RegisterEventHandlers()
    end
    self.Service:Start()
end

function RuntimeMetricsSystem:Stop()
    if type(self.Controller.Stop) == "function" then
        self.Controller:Stop()
    else
        self.Controller:UnregisterEventHandlers()
    end
    self.Service:Stop()
end

return RuntimeMetricsSystem

]]></ProtectedString>
