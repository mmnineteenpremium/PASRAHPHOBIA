				<Item class="ModuleScript" referent="RBX8DE4AFFD057A4E6EBAEB4F6551EE436C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Service = require(script.Parent.Service)
local Controller = require(script.Parent.Controller)
local State = require(script.Parent.State)

local maps = workspace:WaitForChild("Maps")
local lobby = maps:WaitForChild("LobbySocialHub")
local geometry = lobby:FindFirstChild("Geometry")
if not geometry then
    warn("[LobbySocialHub] Geometry folder missing")
end

local LobbySocialHub = {}
LobbySocialHub.__index = LobbySocialHub

function LobbySocialHub.new(deps)
    local self = setmetatable({}, LobbySocialHub)
    self._deps = deps or {}
    self.State = State.new()
    self.Service = Service.new(self.State, self._deps)
    self.Controller = Controller.new(self.State, self.Service, self._deps)
    self.Geometry = geometry
    return self
end

function LobbySocialHub:Init()
    self.Service:Init()
    self.Controller:Init()
end

function LobbySocialHub:Start()
    self.Controller:RegisterEventHandlers()
    self.Service:Start()
end

function LobbySocialHub:Stop()
    self.Controller:UnregisterEventHandlers()
    self.Service:Stop()
end

function LobbySocialHub:Shutdown()
    self:Stop()
end

return LobbySocialHub
]]></ProtectedString>
