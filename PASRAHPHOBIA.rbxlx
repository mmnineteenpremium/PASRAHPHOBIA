				<Item class="ModuleScript" referent="RBX430B8719F61E4949BD28D541A254ACC7">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local RoomManager = {}
RoomManager.__index = RoomManager

local ROOM_COUNT = 100
local MAX_PLAYERS = 4

local ROOM_STATE = {
	WAITING = "waiting",
	READY = "ready",
	STARTING = "starting",
	IN_GAME = "in_game"
}

function RoomManager.new()

	local self = setmetatable({}, RoomManager)

	self.rooms = {}

	for i = 1, ROOM_COUNT do

		self.rooms[i] = {
			id = i,
			players = {},
			maxPlayers = MAX_PLAYERS,
			state = ROOM_STATE.WAITING
		}

	end

	return self

end

function RoomManager:FindAvailableRoom()

	for _,room in pairs(self.rooms) do

		if room.state == ROOM_STATE.WAITING and #room.players < room.maxPlayers then
			return room
		end

	end

	return nil

end

function RoomManager:AddPlayerToRoom(player)

	local room = self:FindAvailableRoom()

	if not room then
		warn("NO ROOM AVAILABLE")
		return nil
	end

	table.insert(room.players, player)

	print(player.Name.." JOIN ROOM "..room.id)

	if #room.players >= room.maxPlayers then
		room.state = ROOM_STATE.READY
	end

	return room

end

function RoomManager:RemovePlayer(player)

	for _,room in pairs(self.rooms) do

		for i,p in ipairs(room.players) do

			if p == player then

				table.remove(room.players,i)

				room.state = ROOM_STATE.WAITING

				print(player.Name.." LEAVE ROOM "..room.id)

				return true

			end

		end

	end

	return false

end

function RoomManager:GetRoomPlayers(roomId)

	local room = self.rooms[roomId]

	if not room then
		return {}
	end

	return room.players

end

function RoomManager:GetRooms()

	return self.rooms

end

return RoomManager
]]></ProtectedString>
