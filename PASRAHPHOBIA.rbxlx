					<Item class="ModuleScript" referent="RBX43C5B11A7BF343F1985987BB656F3DFA">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local InvestigationState = {}
InvestigationState.__index = InvestigationState

function InvestigationState.new()
    local self = setmetatable({}, InvestigationState)
    return self
end

function InvestigationState:CreateMatchState(matchId, now)
    return {
        matchId = matchId,
        createdAt = now or os.clock(),
        ghostType = nil,
        discoveredEvidence = {},
        discoveredByEvidence = {},
        discoveriesByUserId = {},
        possibleGhostTypes = {},
        guessesByUserId = {},
        latestGuessByUserId = {},
        validated = false,
    }
end

function InvestigationState:EnsureMatch(matchMap, matchId, now)
    matchMap[matchId] = matchMap[matchId] or self:CreateMatchState(matchId, now)
    return matchMap[matchId]
end

return InvestigationState
]]></ProtectedString>
							<string name="ScriptGuid">{D0954913-4885-4C86-9AE4-317210E7E7B5}</string>
