						<ProtectedString name="Source"><![CDATA[local Service = require(script.Parent.Service)
local Controller = require(script.Parent.Controller)
local State = require(script.Parent.State)

local GhostDeductionJournal = {}
GhostDeductionJournal.__index = GhostDeductionJournal

function GhostDeductionJournal.new(deps)
    local self = setmetatable({}, GhostDeductionJournal)
    self._deps = deps or {}
    self.State = State.new()
    self.Service = Service.new(self.State, self._deps)
    self.Controller = Controller.new(self.State, self.Service, self._deps)
    return self
end

function GhostDeductionJournal:Init()
    self.Service:Init()
    self.Controller:Init()
end

function GhostDeductionJournal:Start()
    self.Controller:RegisterEventHandlers()
    self.Service:Start()
end

function GhostDeductionJournal:Stop()
    self.Controller:UnregisterEventHandlers()
    self.Service:Stop()
end

return GhostDeductionJournal
