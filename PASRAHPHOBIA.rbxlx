						<ProtectedString name="Source"><![CDATA[local Service = require(script.Parent.Service)
local Controller = require(script.Parent.Controller)
local State = require(script.Parent.State)

local ContentUpdatePipelineSystem = {}
ContentUpdatePipelineSystem.__index = ContentUpdatePipelineSystem

function ContentUpdatePipelineSystem.new(deps)
    local self = setmetatable({}, ContentUpdatePipelineSystem)
    self._deps = deps or {}
    self.State = State.new(self._deps.ContentUpdatePipelineState)
    self.Service = Service.new(self.State, self._deps)
    self.Controller = Controller.new(self.State, self.Service, self._deps)
    return self
end

function ContentUpdatePipelineSystem:Init()
    self.Service:Init()
    self.Controller:Init()
end

function ContentUpdatePipelineSystem:Start()
    self.Controller:Start()
    self.Service:Start()
end

function ContentUpdatePipelineSystem:Stop()
