            { tier = "Detektive", minLevel = 50, divisions = 3, starsPerDivision = 5 },
            { tier = "Sang Ahli", minLevel = 60, divisions = 0, starsPerDivision = 0 },
        },
        rankByUserId = {},
        recentRankUpdates = {},
    }
    return self
end

function State:Get(key)
