					<Item class="ModuleScript" referent="RBX4B26A13362FC4BE3A600E2557C866BEE">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local EvidencePool = {}

EvidencePool.types = {
	"MEDOK",
	"Suhu",
	"Buku Terkutuk",
	"To'un",
	"Suara",
	"Pengganggu"
}

return EvidencePool
