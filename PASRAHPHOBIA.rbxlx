							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">EvidenceTracker</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">536cc62b1ebe128e09c1077b00009063</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXD56E47DE4B4943A3A42F2516050BBD2D">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local EvidenceTrigger = {}

function EvidenceTrigger.trigger(type)
