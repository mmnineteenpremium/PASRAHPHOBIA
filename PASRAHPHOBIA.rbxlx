						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
						<UniqueId name="UniqueId">536cc62b1ebe128e09c1077b000091f7</UniqueId>
					</Properties>
				</Item>
			</Item>
