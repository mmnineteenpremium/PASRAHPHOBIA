		GhostAggression = 1.65,
		HuntFrequency = 1.5,
		EvidenceClarity = 0.65,
		SanityDrain = 1.4,
		DifficultyMode = "Hard",
		RewardMultiplier = 1.7,
	},
}

ModeDifficultyConfig.RankedDifficultyBands = {
	{
		MinMMR = 0,
		MaxMMR = 799,
		Difficulty = "Mudah",
	},
	{
		MinMMR = 800,
