					</Item>
					<Item class="ModuleScript" referent="RBX0C17AFC0D67C4EC8BDFA8C5D02A0A97B">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local State = {}
State.__index = State

local INTERACTIONS = {
    TeamFormation = true,
    PartyInvites = true,
    ProfileInspection = true,
    CosmeticFlex = true,
    ShopInteraction = true,
    TrainingTools = true,
}

function State.new(initial)
    local self = setmetatable({}, State)
    self._data = {
        status = "idle",
        interactions = INTERACTIONS,
    }

    for key, value in pairs(initial or {}) do
        self._data[key] = value
    end

    return self
end

function State:Get(key)
    return self._data[key]
end

function State:Set(key, value)
    self._data[key] = value
end

return State]]></ProtectedString>
							<string name="ScriptGuid">{40D63B9B-6432-413E-83E1-3E300E52600C}</string>
