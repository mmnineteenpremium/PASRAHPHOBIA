		<Item class="Script" referent="RBX08ED0EBF1E1F44178933A3C027335B99">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

-- QueueTrigger dari map
local trigger = workspace.Maps.LobbySocialHub.Geometry.Structures.Layout_Zones.CenterHub.QueueTrigger

-- ambil module MatchQueue
local MatchQueueModule = require(
	game.ServerScriptService.Server.MatchSystem.MatchQueue
)

-- buat instance queue
local Queue = MatchQueueModule.new({
	MinPlayersPerMatch = 1,
	MaxPlayersPerMatch = 4,
})

local queued = {}

trigger.Touched:Connect(function(hit)

	if hit.Name ~= "HumanoidRootPart" then
		return
	end

	local character = hit.Parent
	local player = Players:GetPlayerFromCharacter(character)

	if not player then
		return
	end

	if queued[player] then
		return
	end

	local success, reason = Queue:JoinQueue(player)

	if success then
		queued[player] = true
		print(player.Name.." MASUK MATCH QUEUE")
	else
		print("QUEUE GAGAL:", reason)
	end

end)


trigger.TouchEnded:Connect(function(hit)

	if hit.Name ~= "HumanoidRootPart" then
		return
	end

	local character = hit.Parent
	local player = Players:GetPlayerFromCharacter(character)

	if not player then
		return
	end

	if not queued[player] then
		return
	end

	local success = Queue:LeaveQueue(player)

	if success then
		queued[player] = nil
		print(player.Name.." KELUAR MATCH QUEUE")
	end

end)]]></ProtectedString>
