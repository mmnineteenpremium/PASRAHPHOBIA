			<Item class="LocalScript" referent="RBX9840A2653A034B71AE9EB42ED9E21DD8">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ENABLE_LEGACY_ROOM_BROWSER_DEBUG_UI = false
if not ENABLE_LEGACY_ROOM_BROWSER_DEBUG_UI then
	return
end

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local lobbyEvent = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("LobbyEvent")

local state = {
	mode = "Classic",
	difficulty = "Mudah",
	rooms = {},
	error = nil,
	queue = nil,
}

local function send(action, payload)
	local data = payload or {}
	data.action = action
	lobbyEvent:FireServer(data)
end

local function getQueuePart()
	return workspace:FindFirstChild("QueueTrigger", true) or workspace:FindFirstChild("MatchQueueTrigger", true)
end

local function isNearQueue()
	local qp = getQueuePart()
	if not (qp and qp:IsA("BasePart")) then
		return false
	end
	local ch = player.Character
	if not ch then
		return false
	end
	local root = ch:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	return (root.Position - qp.Position).Magnitude <= 30
end

for _, n in ipairs({ "RoomBrowserDebugUI", "RoomBrowserFloatUI" }) do
	local old = playerGui:FindFirstChild(n)
	if old then
		old:Destroy()
	end
end

local gui = Instance.new("ScreenGui")
gui.Name = "RoomBrowserFloatUI"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local function mkBtn(parent, text, x, y, w, h)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Position = UDim2.fromOffset(x, y)
	b.Size = UDim2.fromOffset(w, h)
	b.Font = Enum.Font.GothamSemibold
	b.TextSize = 14
	b.TextColor3 = Color3.fromRGB(245, 245, 245)
	b.BackgroundColor3 = Color3.fromRGB(47, 60, 80)
	b.BorderSizePixel = 0
	b.Parent = parent
	return b
end

local toggle = Instance.new("TextButton")
toggle.Name = "ToggleRoomBrowser"
toggle.AnchorPoint = Vector2.new(1, 0.5)
toggle.Position = UDim2.new(1, -16, 0.5, 0)
toggle.Size = UDim2.fromOffset(150, 46)
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 14
toggle.TextColor3 = Color3.fromRGB(245, 245, 245)
toggle.BackgroundColor3 = Color3.fromRGB(80, 120, 190)
toggle.BorderSizePixel = 0
toggle.Text = "OPEN ROOM"
toggle.Parent = gui

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Position = UDim2.new(1, -176, 0.5, 0)
panel.Size = UDim2.fromOffset(420, 470)
panel.BackgroundColor3 = Color3.fromRGB(23, 30, 40)
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = gui

local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Position = UDim2.fromOffset(12, 8)
title.Size = UDim2.fromOffset(390, 24)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Font = Enum.Font.GothamBold
title.TextSize = 20
title.TextColor3 = Color3.fromRGB(245, 245, 245)
title.Text = "ROOM BROWSER"
title.Parent = panel

local status = Instance.new("TextLabel")
status.BackgroundTransparency = 1
status.Position = UDim2.fromOffset(12, 34)
status.Size = UDim2.fromOffset(390, 20)
status.TextXAlignment = Enum.TextXAlignment.Left
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.TextColor3 = Color3.fromRGB(200, 210, 225)
status.Text = "Loading..."
status.Parent = panel

local closeBtn = mkBtn(panel, "CLOSE", 334, 8, 74, 24)
closeBtn.BackgroundColor3 = Color3.fromRGB(135, 65, 65)

local btnClassic = mkBtn(panel, "Classic", 12, 62, 194, 30)
local btnRanked = mkBtn(panel, "Ranked", 214, 62, 194, 30)

local diffWrap = Instance.new("Frame")
diffWrap.BackgroundTransparency = 1
diffWrap.Position = UDim2.fromOffset(12, 98)
diffWrap.Size = UDim2.fromOffset(396, 34)
diffWrap.Parent = panel

local btnMudah = mkBtn(diffWrap, "Mudah", 0, 0, 96, 30)
local btnLumayan = mkBtn(diffWrap, "Lumayan", 100, 0, 96, 30)
local btnAngker = mkBtn(diffWrap, "Angker", 200, 0, 96, 30)
local btnUji = mkBtn(diffWrap, "Uji Nyali", 300, 0, 96, 30)

local roomList = Instance.new("ScrollingFrame")
roomList.Position = UDim2.fromOffset(12, 138)
roomList.Size = UDim2.fromOffset(396, 280)
roomList.BackgroundColor3 = Color3.fromRGB(33, 43, 57)
roomList.BorderSizePixel = 0
roomList.ScrollBarThickness = 8
roomList.CanvasSize = UDim2.fromOffset(0, 360)
roomList.Parent = panel

local rows = {}
for i = 1, 10 do
	local row = mkBtn(roomList, "Room " .. i .. " | kosong", 8, 8 + (i - 1) * 34, 380, 30)
	row.Font = Enum.Font.Gotham
	row.TextSize = 13
	row.TextXAlignment = Enum.TextXAlignment.Left
	row.BackgroundColor3 = Color3.fromRGB(45, 56, 74)
	row.Activated:Connect(function()
		local roomId = row:GetAttribute("roomId")
		if roomId then
			send("JoinRoom", { roomId = roomId })
		end
	end)
	rows[i] = row
end

local btnRefresh = mkBtn(panel, "Refresh", 12, 428, 126, 32)
local btnLeave = mkBtn(panel, "Leave", 146, 428, 126, 32)
local btnQueue = mkBtn(panel, "Queue", 282, 428, 126, 32)
btnQueue.BackgroundColor3 = Color3.fromRGB(70, 120, 84)

local function setSel(btn, on)
	btn.BackgroundColor3 = on and Color3.fromRGB(87, 125, 185) or Color3.fromRGB(47, 60, 80)
end

local function render()
	diffWrap.Visible = state.mode == "Classic"

	setSel(btnClassic, state.mode == "Classic")
	setSel(btnRanked, state.mode == "Ranked")
	setSel(btnMudah, state.difficulty == "Mudah")
	setSel(btnLumayan, state.difficulty == "Lumayan")
	setSel(btnAngker, state.difficulty == "Angker")
	setSel(btnUji, state.difficulty == "Uji Nyali")

	local txt = "Mode: " .. tostring(state.mode) .. " | Difficulty: " .. tostring(state.difficulty) .. " | Rooms: " .. tostring(#state.rooms)
	if state.queue then
		txt = txt .. " | Queue: started"
	end
	if state.error then
		txt = txt .. " | Error: " .. tostring(state.error)
	end
	status.Text = txt

	for i = 1, 10 do
		local room = state.rooms[i]
		local row = rows[i]
		if room then
			local roomId = room.roomId or i
			local pc = room.playerCount or 0
			local mp = room.maxPlayers or 4
			local mode = room.mode or "Classic"
			local diff = room.difficulty or "-"
			row.Text = string.format("Room %d | %s | %s | %d/%d", roomId, mode, diff, pc, mp)
			row:SetAttribute("roomId", roomId)
			row.AutoButtonColor = true
		else
			row.Text = "Room " .. i .. " | kosong"
			row:SetAttribute("roomId", nil)
			row.AutoButtonColor = false
		end
	end
end

local function setPanelVisible(v)
	panel.Visible = v
	toggle.Text = v and "CLOSE ROOM" or "OPEN ROOM"
end

toggle.Activated:Connect(function()
	setPanelVisible(not panel.Visible)
	if panel.Visible then
		send("RequestRoomBrowserSnapshot")
		send("RequestRoomList")
	end
end)

closeBtn.Activated:Connect(function()
	setPanelVisible(false)
end)

btnClassic.Activated:Connect(function()
	send("SelectMode", { mode = "Classic" })
end)
btnRanked.Activated:Connect(function()
	send("SelectMode", { mode = "Ranked" })
end)
btnMudah.Activated:Connect(function()
	send("SelectDifficulty", { difficulty = "Mudah" })
end)
btnLumayan.Activated:Connect(function()
	send("SelectDifficulty", { difficulty = "Lumayan" })
end)
btnAngker.Activated:Connect(function()
	send("SelectDifficulty", { difficulty = "Angker" })
end)
btnUji.Activated:Connect(function()
	send("SelectDifficulty", { difficulty = "Uji Nyali" })
end)
btnRefresh.Activated:Connect(function()
	send("RequestRoomBrowserSnapshot")
	send("RequestRoomList")
end)
btnLeave.Activated:Connect(function()
	send("LeaveRoom")
end)
btnQueue.Activated:Connect(function()
	send("QueueFromRoomBrowser")
end)

lobbyEvent.OnClientEvent:Connect(function(payload)
	local eventName = payload and payload.eventName
	if eventName == "RoomBrowserSnapshot" then
		local snap = payload.snapshot or {}
		state.mode = snap.selectedMode or state.mode
		state.difficulty = snap.selectedDifficulty or state.difficulty
		state.rooms = snap.rooms or state.rooms
		state.error = nil
	elseif eventName == "RoomBrowserRoomList" then
		state.rooms = payload.rooms or state.rooms
	elseif eventName == "RoomBrowserSelectionConfirmed" then
		local sel = payload.selection or {}
		state.mode = sel.mode or state.mode
		state.difficulty = sel.difficulty or state.difficulty
		state.error = nil
	elseif eventName == "RoomBrowserQueueStarted" then
		state.queue = payload.queue or true
		state.error = nil
	elseif eventName == "RoomBrowserSelectionRejected" or eventName == "RoomBrowserError" then
		state.error = payload.reason or eventName
	elseif eventName and string.find(eventName, "Failed", 1, true) then
		state.error = payload.reason or eventName
	end
	render()
end)

local wasNear = false
RunService.RenderStepped:Connect(function()
	local near = isNearQueue()
	local bob = math.floor(math.sin(time() * 2.2) * 4)

	toggle.Position = UDim2.new(1, -16, 0.5, bob)

	if panel.Visible then
		panel.Position = UDim2.new(1, -176, 0.5, near and bob or 0)
	end

	if near and not wasNear and not panel.Visible then
		setPanelVisible(true)
		send("RequestRoomBrowserSnapshot")
		send("RequestRoomList")
	end

	wasNear = near
end)

task.spawn(function()
	while gui.Parent do
		if panel.Visible then
			send("RequestRoomBrowserSnapshot")
			send("RequestRoomList")
		end
		task.wait(2.5)
	end
end)

send("RequestRoomBrowserSnapshot")
send("RequestRoomList")
render()
]]></ProtectedString>
