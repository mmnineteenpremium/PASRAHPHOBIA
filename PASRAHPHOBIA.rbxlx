						<ProtectedString name="Source"><![CDATA[local ElectronicDisturbance = {}
ElectronicDisturbance.__index = ElectronicDisturbance

local function copy(value)
	local out = {}
	for k, v in pairs(value or {}) do
		out[k] = v
	end
	return out
end

function ElectronicDisturbance.new()
