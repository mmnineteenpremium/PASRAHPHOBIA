    self._data[key] = value
end

function State:Clear()
    table.clear(self._data)
end

return State
]]></ProtectedString>
						<string name="ScriptGuid">{FBA38078-51CC-43B7-9B70-8FBD4906239D}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
