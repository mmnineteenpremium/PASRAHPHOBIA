		<Item class="Script" referent="RBX47E48A486C9D4EBFA67D8FF435764913">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local remotes = RS:WaitForChild("RemoteEvents", 10)
local ev = remotes and remotes:WaitForChild("LobbyEvent", 10)
if not ev then return end

local function findQueue()
	for _, n in ipairs({"QueueTrigger","MatchQueueTrigger","QueueZone","MatchmakingZone","QueueArea"}) do
		local p = workspace:FindFirstChild(n, true)
		if p and p:IsA("BasePart") then return p end
	end
	return nil
end

local function tp(player)
	local q = findQueue()
	if not q then return false end
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local dist = (hrp.Position - q.Position).Magnitude
	if dist <= 30 then return true end
	local target = q.CFrame + Vector3.new(0, 4, 0)
	local ok = pcall(function() ch:PivotTo(target) end)
	if not ok then hrp.CFrame = target end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	print("[LobbyTeleportOnlyBridge] teleported", player.Name, math.floor(dist))
	return true
end

ev.OnServerEvent:Connect(function(player, payload)
	if type(payload) ~= "table" then return end
	local a = payload.action
	if a ~= "JoinRoom" and a ~= "QueueFromRoomBrowser" then return end
	task.spawn(function()
		for _ = 1, 20 do
			if tp(player) then return end
			task.wait(0.1)
		end
	end)
end)

print("[LobbyTeleportOnlyBridge] ACTIVE")
]]></ProtectedString>
