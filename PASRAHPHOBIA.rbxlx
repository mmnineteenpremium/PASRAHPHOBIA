						<ProtectedString name="Source"><![CDATA[local Service = require(script.Parent.Service)
local Controller = require(script.Parent.Controller)
local State = require(script.Parent.State)

local SystemDiagnosticsController = {}
SystemDiagnosticsController.__index = SystemDiagnosticsController

function SystemDiagnosticsController.new(deps)
    local self = setmetatable({}, SystemDiagnosticsController)
    self._deps = deps or {}
    self.State = State.new()
    self.Service = Service.new(self.State, self._deps)
    self.Controller = Controller.new(self.State, self.Service, self._deps)
    return self
end

function SystemDiagnosticsController:Init()
    self.Service:Init()
    self.Controller:Init()
end

function SystemDiagnosticsController:Start()
    self.Controller:RegisterEventHandlers()
    self.Service:Start()
end

function SystemDiagnosticsController:Stop()
    self.Controller:UnregisterEventHandlers()
    self.Service:Stop()
end

return SystemDiagnosticsController
