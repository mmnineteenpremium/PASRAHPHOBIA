						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Dev = {}

local Players = game:GetService("Players")

local function getRegistry()
    local registry = _G.SystemRegistry
    if type(registry) == "table" then
        return registry
    end

    local ok, loaded = pcall(function()
        return require(game.ServerScriptService.Server.Core.SystemRegistry)
    end)
    if ok and type(loaded) == "table" then
        return loaded
    end

    return nil
end

local function getSystem(name)
    local registry = getRegistry()
    local system = nil

    if type(registry) == "table" and type(registry.Get) == "function" then
        system = registry:Get(name)
    end

    if system == nil and type(registry) == "table" and type(registry.GetService) == "function" then
        system = registry:GetService(name)
    end

    if system == nil then
        error(name .. " not registered")
    end

    return system
end

local function getMatchService()
    local matchSystem = getSystem("MatchSystem")

    if type(matchSystem) == "table" and type(matchSystem.Service) == "table" then
        return matchSystem.Service
    end

    return matchSystem
end

function Dev.Match(mode)
    print("[DEV] forcing match creation")

    local MatchService = getMatchService()

    for _, player in pairs(Players:GetPlayers()) do
        MatchService:JoinQueue(player, {
            mode = mode or "Classic",
        })
    end

    local match, reason = MatchService:TryCreateMatchFromQueue()

    print("[DEV] match result", match, reason)
end

return Dev
]]></ProtectedString>
