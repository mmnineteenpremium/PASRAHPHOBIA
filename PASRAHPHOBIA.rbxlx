					<Item class="ModuleScript" referent="RBX5B1E702132204911B9723DE12B5D60F6">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local SpectatorDistortionRules = {}

SpectatorDistortionRules.Probabilities = {
    fake = 60,
    uncertain = 30,
    real = 10,
}

SpectatorDistortionRules.EventTypes = {
    fake = {
        "FakeGhostMovement",
        "FakeShadow",
        "FakeSound",
        "FakeObjectInteraction",
    },
    uncertain = {
        "AmbiguousShadow",
        "AmbiguousSound",
        "AmbiguousMovement",
    },
    real = {
        "RealGhostEvent",
    },
}

function SpectatorDistortionRules:GetProbability(outcome)
    return self.Probabilities[outcome] or 0
end

function SpectatorDistortionRules:GetOutcomes()
    return {
        "fake",
        "uncertain",
        "real",
    }
end

return SpectatorDistortionRules
]]></ProtectedString>
