local ServerScriptService = game:GetService("ServerScriptService")

if not RunService:IsStudio() then
    return
end

local function resolveDevModule(moduleName)
    local candidates = {
        script,
        script.Parent,
        script.Parent and script.Parent:FindFirstChild("Dev"),
    }

    for _, container in ipairs(candidates) do
        if container then
            local moduleScript = container:FindFirstChild(moduleName)
            if moduleScript then
                return moduleScript
            end
        end
    end

    return nil
end

local devModule = resolveDevModule("dev_commands")
local validationModule = resolveDevModule("Phase4ValidationCommands")

if not devModule or not validationModule then
    warn("[Dev] Missing dev command modules; skipping dev globals setup")
    return
end

local Dev = require(devModule)
