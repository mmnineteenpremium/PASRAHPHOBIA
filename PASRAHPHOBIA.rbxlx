_G.Dev = Dev
_G.DevCommands = DevCommands

local hasDevTestScript = ServerScriptService:FindFirstChild("DevTestCommands") ~= nil
if not hasDevTestScript then
    warn("[Dev] DevTestCommands script is missing from ServerScriptService")
end

print("[Dev] Command globals ready: _G.Dev, _G.DevCommands; DevTest mapped =", hasDevTestScript)
