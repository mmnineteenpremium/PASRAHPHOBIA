						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Service</string>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
						<UniqueId name="UniqueId">536cc62b1ebe128e09c1077b000090a2</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC6C16036BF17489699C20AD3C2DB727D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local State = {}
State.__index = State
local DEFAULT_STATE = {
    currentPhase = "Lobby",
    phaseStartAt = 0,
    activeMatchId = nil,
}
local function deepCopy(value)
    if type(value) ~= "table" then return value end
    local out = {}
    for key, nested in pairs(value) do out[key] = deepCopy(nested) end
    return out
end
function State.new() local self = setmetatable({}, State); self._data = deepCopy(DEFAULT_STATE); return self end
function State:Get(key) return self._data[key] end
function State:Set(key, value) self._data[key] = value end
function State:Clear() self._data = deepCopy(DEFAULT_STATE) end
return State
]]></ProtectedString>
