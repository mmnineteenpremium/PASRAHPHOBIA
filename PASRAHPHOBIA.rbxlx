        interaction = "GhostWriting"
    },

    GerakanGaib = {
        tool = "GerakanGaib",
        motionRequired = true
    },

    JejakEnergi = {
        tool = "JejakEnergi",
        surfaceTrace = true
    },

    KotakArwah = {
        tool = "KotakArwah",
        voiceResponse = true
    },

    SuhuMembeku = {
        tool = "Thermo",
        freezingTemp = true
    }

}

