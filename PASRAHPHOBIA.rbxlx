						<UniqueId name="UniqueId">25e0b8fae4acec0209bed82d000016ec</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX282DD9CF25B246ED88FBCC485D963603">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local State = {}
State.__index = State

local DEFAULT_STATE = {
    activeEventId = nil,
    activeEvent = nil,
    eventOverrides = {},
    history = {},
    lastRefreshAt = 0,
}

local function deepCopy(value)
    if type(value) ~= "table" then
        return value
    end
    local out = {}
    for key, nested in pairs(value) do
        out[key] = deepCopy(nested)
    end
    return out
end

function State.new(seed)
    local self = setmetatable({}, State)
    self._data = deepCopy(DEFAULT_STATE)
    for key, value in pairs(seed or {}) do
        self._data[key] = value
    end
    return self
end

function State:Get(key)
    return self._data[key]
end

function State:Set(key, value)
    self._data[key] = value
end

function State:AppendHistory(entry)
    local history = self._data.history or {}
    table.insert(history, entry)
    if #history > 100 then
        table.remove(history, 1)
    end
    self._data.history = history
end

function State:Clear()
    self._data = deepCopy(DEFAULT_STATE)
end

return State
]]></ProtectedString>
