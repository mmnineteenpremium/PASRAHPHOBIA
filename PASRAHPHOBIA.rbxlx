				<Item class="ModuleScript" referent="RBX832DF4A69CBE411AAA70C47CA3A606D0">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Services = require(script.Parent.Parent.Core.Services)

local Service = {}
Service.__index = Service

local DEFAULT_CONFIG = {
	WindowSeconds = 5,
	RemoteSpamThreshold = 20,
	TemporaryBlockSeconds = 10,
}

local function resolveEventBus(deps)
	local eventBus = Services.Get(deps, "EventBus")
	if type(eventBus) ~= "table" then
		return nil
	end
	if type(eventBus.Publish) == "function" then
		return eventBus
	end
	if type(eventBus.Service) == "table" and type(eventBus.Service.Publish) == "function" then
		return eventBus.Service
	end
	return nil
end

local function resolveUserId(payload)
	if type(payload.playerId) == "number" then
		return payload.playerId
	end
	if type(payload.userId) == "number" then
		return payload.userId
	end
	local player = payload.player
	if typeof(player) == "Instance" and player:IsA("Player") then
		return player.UserId
	end
	return nil
end

local function mergeConfig(base, override)
	local out = {}
	for k, v in pairs(base) do
		out[k] = v
	end
	for k, v in pairs(override or {}) do
		out[k] = v
	end
	return out
end

function Service.new(state, deps)
	local self = setmetatable({}, Service)
	self._state = state
	self._deps = deps or {}
	self._config = mergeConfig(DEFAULT_CONFIG, self._deps.ExploitDetectionConfig)
	self._eventBus = nil
	self._dependencies = {}
	return self
end

function Service:Create()
	self._eventBus = resolveEventBus(self._deps)
	self._dependencies = {
		MatchSystem = Services.Get(self._deps, "MatchSystem"),
		ProfileSystem = Services.Get(self._deps, "ProfileSystem"),
		DataPersistenceService = Services.Get(self._deps, "DataPersistenceService"),
		LobbySocialHub = Services.Get(self._deps, "LobbySocialHub"),
	}
end

function Service:Init()
	self._state:Set("remoteCallCounters", self._state:Get("remoteCallCounters") or {})
	self._state:Set("suspiciousPlayers", self._state:Get("suspiciousPlayers") or {})
	self._state:Set("throttledPlayers", self._state:Get("throttledPlayers") or {})
end

function Service:Start()
	-- Event-driven.
end

function Service:Stop()
	self._state:Clear()
end

function Service:_publish(eventName, payload)
	if self._eventBus then
		self._eventBus:Publish(eventName, payload)
	end
end

function Service:_markSuspicious(userId, reason, payload)
	local suspiciousPlayers = self._state:Get("suspiciousPlayers") or {}
	suspiciousPlayers[userId] = {
		reason = reason,
		lastSeen = os.time(),
	}
	self._state:Set("suspiciousPlayers", suspiciousPlayers)

	self:_publish("ExploitPatternDetected", {
		userId = userId,
		reason = reason,
		payload = payload,
	})
end

function Service:_applyThrottle(userId, reason)
	local throttled = self._state:Get("throttledPlayers") or {}
	throttled[userId] = os.clock() + self._config.TemporaryBlockSeconds
	self._state:Set("throttledPlayers", throttled)

	self:_publish("RemoteSpamDetected", {
		userId = userId,
		reason = reason,
		blockUntil = throttled[userId],
	})
end

function Service:IsThrottled(userId)
	local throttled = self._state:Get("throttledPlayers") or {}
	local untilAt = throttled[userId]
	if not untilAt then
		return false
	end
	if untilAt <= os.clock() then
		throttled[userId] = nil
		self._state:Set("throttledPlayers", throttled)
		return false
	end
	return true
end

function Service:OnRemoteEventTriggered(payload)
	payload = payload or {}
	local userId = resolveUserId(payload)
	if not userId then
		return
	end

	if self:IsThrottled(userId) then
		self:_publish("ExploitPatternDetected", {
			userId = userId,
			reason = "remote_call_while_throttled",
			payload = payload,
		})
		return
	end

	local counters = self._state:Get("remoteCallCounters") or {}
	local now = os.clock()
	local record = counters[userId] or {
		windowStartedAt = now,
		count = 0,
	}

	if (now - record.windowStartedAt) > self._config.WindowSeconds then
		record.windowStartedAt = now
		record.count = 0
	end

	record.count += 1
	counters[userId] = record
	self._state:Set("remoteCallCounters", counters)

	if record.count > self._config.RemoteSpamThreshold then
		self:_markSuspicious(userId, "remote_spam", {
			count = record.count,
			remoteName = payload.remoteName,
		})
		self:_applyThrottle(userId, "remote_spam")
	end

	if payload.authorized == false then
		self:_markSuspicious(userId, "unauthorized_remote_call", payload)
	end
end

function Service:OnPlayerDisconnected(payload)
	local userId = resolveUserId(payload or {})
	if not userId then
		return
	end
	local counters = self._state:Get("remoteCallCounters") or {}
	counters[userId] = nil
	self._state:Set("remoteCallCounters", counters)
end

return Service
]]></ProtectedString>
