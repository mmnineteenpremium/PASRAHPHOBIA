							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local UISystem = {}
UISystem.__index = UISystem
local RoomBrowserController = require(script.Parent.RoomBrowserController)

local UI_MODULES = {
	"JournalUI",
	"LobbyUI",
	"MatchUI",
	"ProfileUI",
	"ShopUI",
	"PASRA_UI",
	"SpectatorUI",
}

local REMOTE_NAMES = { "MatchEvent", "LobbyEvent", "EvidenceEvent", "PurchaseEvent", "SanityEvent" }
local ROOM_ROW_COUNT = 10
local BASIC_GUI_NAMES = {
	"LobbyUI",
	"MatchUI",
	"ProfileUI",
	"ShopUI",
	"PASRA_UI",
	"SpectatorUI",
	"LeaderboardUI",
	"MainMenuUI",
}

local function styleButton(button, text)
	button.Text = text
	button.TextColor3 = Color3.fromRGB(245, 245, 245)
	button.Font = Enum.Font.GothamSemibold
	button.TextSize = 14
	button.BorderSizePixel = 0
	button.BackgroundColor3 = Color3.fromRGB(46, 57, 73)
end

local function styleLabel(label, text, size)
	label.Text = text
	label.TextColor3 = Color3.fromRGB(235, 240, 245)
	label.Font = Enum.Font.Gotham
	label.TextSize = size or 14
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left
end

function UISystem:Init(context)
	self._context = context
	self._remotes = context.Remotes
	self._connections = {}
	self._uiState = {}
	self._roomBrowser = RoomBrowserController.new(self._remotes and self._remotes.LobbyEvent or nil)
	self._roomBrowserGui = nil
	self._roomBrowserWidgets = nil
	self._roomBrowserLoopRunning = false

	for _, moduleName in ipairs(UI_MODULES) do
		self._uiState[moduleName] = {
			lastEvent = nil,
			visible = false,
		}
	end

	self._matchResult = {
		ghostType = "Unknown",
		correctGuess = false,
		evidenceCollected = 0,
		playersSurvived = 0,
		playersDead = 0,
		matchDuration = 0,
		currencyReward = 0,
		xpReward = 0,
	}
end

function UISystem:Start()
	for _, remoteName in ipairs(REMOTE_NAMES) do
		local remote = self._remotes[remoteName]
		if remote and remote.OnClientEvent then
			table.insert(self._connections, remote.OnClientEvent:Connect(function(payload)
				self:_onServerEvent(remoteName, payload)
			end))
		end
	end

	if self._roomBrowser then
		self._roomBrowser:Start()
	end

	self:_ensureBasicUIs()
	self:_ensureRoomBrowserGui()
	self:_refreshRoomBrowserView()
	self:_startRoomBrowserLoop()
end

function UISystem:_onServerEvent(remoteName, payload)
	local eventName = payload and payload.eventName or "UnknownEvent"

	if remoteName == "EvidenceEvent" then
		self._uiState.JournalUI.lastEvent = eventName
		self._uiState.JournalUI.visible = true
	elseif remoteName == "LobbyEvent" then
		self._uiState.LobbyUI.lastEvent = eventName
		self._uiState.LobbyUI.visible = true
		if self._roomBrowser then
			self._roomBrowser:HandleLobbyEvent(payload or {})
		end
		self:_refreshRoomBrowserView()
	elseif remoteName == "MatchEvent" then
		self._uiState.MatchUI.lastEvent = eventName
		self._uiState.MatchUI.visible = true
		if eventName == "PlayerKilled" and payload and payload.localPlayerKilled == true then
			self._uiState.SpectatorUI.lastEvent = eventName
			self._uiState.SpectatorUI.visible = true
		elseif eventName == "MatchEnded" then
			self._uiState.PASRA_UI.lastEvent = eventName
			self._uiState.PASRA_UI.visible = true
			self._uiState.SpectatorUI.visible = false
			self._uiState.MatchUI.visible = false
			self._matchResult = {
				ghostType = payload.ghostType or "Unknown",
				correctGuess = payload.correctGuess == true,
				evidenceCollected = payload.evidenceCollected or 0,
				playersSurvived = payload.playersSurvived or 0,
				playersDead = payload.playersDead or 0,
				matchDuration = payload.matchDuration or 0,
				currencyReward = payload.currencyReward or 0,
				xpReward = payload.xpReward or 0,
			}
		elseif eventName == "MatchStarted" then
			self._uiState.PASRA_UI.visible = false
			self._uiState.MatchUI.visible = true
			self._uiState.SpectatorUI.visible = false
		end
	elseif remoteName == "PurchaseEvent" then
		self._uiState.ShopUI.lastEvent = eventName
		self._uiState.ShopUI.visible = true
	elseif remoteName == "SanityEvent" then
		self._uiState.ProfileUI.lastEvent = eventName
		self._uiState.ProfileUI.visible = true
	end

	self:_applyVisibility()
end

function UISystem:_applyVisibility()
	for _, guiName in ipairs(BASIC_GUI_NAMES) do
		local gui = self:_getPlayerGuiInstance(guiName)
		if gui then
			local state = self._uiState[guiName]
			if state then
				gui.Enabled = state.visible == true
			end
		end
	end
end

function UISystem:_getPlayerGuiInstance(guiName)
	local player = Players.LocalPlayer
	if not player then
		return nil
	end
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
	if not playerGui then
		return nil
	end
	return playerGui:FindFirstChild(guiName)
end

function UISystem:_ensureBasicUIs()
	for _, guiName in ipairs(BASIC_GUI_NAMES) do
		self:_ensureBasicGui(guiName)
	end
	self:_applyVisibility()
end

function UISystem:_ensureBasicGui(guiName)
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
	if not playerGui then
		return
	end

	local gui = playerGui:FindFirstChild(guiName)
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = guiName
		gui.ResetOnSpawn = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = playerGui
	end

	if gui:FindFirstChild("MainPanel") then
		return
	end

	local panel = Instance.new("Frame")
	panel.Name = "MainPanel"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -16, 0, 16)
	panel.Size = UDim2.fromOffset(260, 320)
	panel.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
	panel.BorderSizePixel = 0
	panel.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Position = UDim2.fromOffset(12, 10)
	title.Size = UDim2.fromOffset(236, 22)
	styleLabel(title, guiName)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 16
	title.Parent = panel

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.Position = UDim2.fromOffset(12, 36)
	status.Size = UDim2.fromOffset(236, 18)
	styleLabel(status, "Ready")
	status.TextSize = 12
	status.Parent = panel

	local function addButton(name, text, y, callback)
		local button = Instance.new("TextButton")
		button.Name = name
		button.Position = UDim2.fromOffset(12, y)
		button.Size = UDim2.fromOffset(236, 30)
		styleButton(button, text)
		button.Parent = panel
		if callback then
			button.Activated:Connect(callback)
		end
		return button
	end

	local y = 64
	if guiName == "LobbyUI" then
		addButton("OpenRoomBrowser", "Open Room Browser", y, function()
			if self._roomBrowser then
				self._roomBrowser:RequestSnapshot()
				self._roomBrowser:RequestRoomList()
			end
			status.Text = "Room Browser opened"
		end); y += 36
		addButton("Queue", "Queue", y, function()
			self:RoomBrowserQueueSelected()
			status.Text = "Queue requested"
		end); y += 36
		addButton("Close", "Close Lobby UI", y, function()
			self._uiState.LobbyUI.visible = false
			self:_applyVisibility()
		end)
	elseif guiName == "ShopUI" then
		addButton("RequestCatalog", "Request Catalog", y, function()
			status.Text = "Catalog requested"
		end); y += 36
		addButton("TestPurchase", "Test Purchase", y, function()
			if self._remotes and self._remotes.PurchaseEvent then
				self._remotes.PurchaseEvent:FireServer({
					action = "PurchaseItem",
					itemId = "Cosmetic_Hat_01",
					requestId = tostring(os.time()),
				})
				status.Text = "Purchase request sent"
			else
				status.Text = "Purchase remote missing"
			end
		end); y += 36
		addButton("Close", "Close Shop UI", y, function()
			self._uiState.ShopUI.visible = false
			self:_applyVisibility()
		end)
	elseif guiName == "ProfileUI" then
		addButton("RefreshProfile", "Refresh Profile", y, function()
			status.Text = "Profile refreshed"
		end); y += 36
		addButton("Toggle", "Toggle Profile UI", y, function()
			self._uiState.ProfileUI.visible = not self._uiState.ProfileUI.visible
			self:_applyVisibility()
		end)
	elseif guiName == "MatchUI" then
		addButton("MatchStatus", "Show Match Status", y, function()
			status.Text = string.format("Ghost: %s", tostring(self._matchResult.ghostType))
		end); y += 36
		addButton("Close", "Close Match UI", y, function()
			self._uiState.MatchUI.visible = false
			self:_applyVisibility()
		end)
	elseif guiName == "PASRA_UI" then
		addButton("ShowResults", "Show Results", y, function()
			status.Text = string.format("Reward: %d | XP: %d", self._matchResult.currencyReward, self._matchResult.xpReward)
		end); y += 36
		addButton("Close", "Close Results", y, function()
			self._uiState.PASRA_UI.visible = false
			self:_applyVisibility()
		end)
	elseif guiName == "SpectatorUI" then
		addButton("TestDeathNotice", "Test Death Notice", y, function()
			status.Text = "Kematian menipumu..."
		end); y += 36
		addButton("Close", "Close Spectator UI", y, function()
			self._uiState.SpectatorUI.visible = false
			self:_applyVisibility()
		end)
	else
		addButton("Toggle", "Toggle UI", y, function()
			if self._uiState[guiName] then
				self._uiState[guiName].visible = not self._uiState[guiName].visible
				self:_applyVisibility()
			end
		end)
	end
end

function UISystem:_ensureRoomBrowserGui()
	if self._roomBrowserGui then
		return
	end

	local player = Players.LocalPlayer
	if not player then
		return
	end

	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
	if not playerGui then
		return
	end

	for _, guiName in ipairs({ "RoomBrowserUI", "RoomBrowserDebugUI", "RoomBrowserFloatUI" }) do
		local existing = playerGui:FindFirstChild(guiName)
		if existing then
			existing:Destroy()
		end
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "RoomBrowserUI"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0, 0.5)
	panel.Position = UDim2.fromOffset(16, 280)
	panel.Size = UDim2.fromOffset(420, 460)
	panel.BackgroundColor3 = Color3.fromRGB(22, 27, 35)
	panel.BorderSizePixel = 0
	panel.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 10)
	title.Size = UDim2.fromOffset(390, 24)
	title.Text = "Room Browser"
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Font = Enum.Font.GothamBold
	title.TextSize = 18
	title.TextColor3 = Color3.fromRGB(245, 245, 245)
	title.Parent = panel

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Position = UDim2.fromOffset(14, 36)
	status.Size = UDim2.fromOffset(390, 20)
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Font = Enum.Font.Gotham
	status.TextSize = 13
	status.TextColor3 = Color3.fromRGB(195, 205, 220)
	status.Text = "Memuat snapshot..."
	status.Parent = panel

	local modeLabel = Instance.new("TextLabel")
	modeLabel.BackgroundTransparency = 1
	modeLabel.Position = UDim2.fromOffset(14, 66)
	modeLabel.Size = UDim2.fromOffset(390, 18)
	modeLabel.Text = "Mode"
	modeLabel.TextXAlignment = Enum.TextXAlignment.Left
	modeLabel.Font = Enum.Font.GothamSemibold
	modeLabel.TextSize = 13
	modeLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
	modeLabel.Parent = panel

	local classicButton = Instance.new("TextButton")
	classicButton.Name = "ClassicButton"
	classicButton.Position = UDim2.fromOffset(14, 86)
	classicButton.Size = UDim2.fromOffset(188, 30)
	styleButton(classicButton, "Classic")
	classicButton.Parent = panel

	local rankedButton = Instance.new("TextButton")
	rankedButton.Name = "RankedButton"
	rankedButton.Position = UDim2.fromOffset(216, 86)
	rankedButton.Size = UDim2.fromOffset(188, 30)
	styleButton(rankedButton, "Ranked")
	rankedButton.Parent = panel

	local difficultyLabel = Instance.new("TextLabel")
	difficultyLabel.Name = "DifficultyLabel"
	difficultyLabel.BackgroundTransparency = 1
	difficultyLabel.Position = UDim2.fromOffset(14, 122)
	difficultyLabel.Size = UDim2.fromOffset(390, 18)
	difficultyLabel.Text = "Classic Difficulty"
	difficultyLabel.TextXAlignment = Enum.TextXAlignment.Left
	difficultyLabel.Font = Enum.Font.GothamSemibold
	difficultyLabel.TextSize = 13
	difficultyLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
	difficultyLabel.Parent = panel

	local difficultyContainer = Instance.new("Frame")
	difficultyContainer.Name = "DifficultyContainer"
	difficultyContainer.BackgroundTransparency = 1
	difficultyContainer.Position = UDim2.fromOffset(14, 142)
	difficultyContainer.Size = UDim2.fromOffset(390, 34)
	difficultyContainer.Parent = panel

	local difficultyButtons = {}
	local difficultyNames = { "Mudah", "Lumayan", "Angker", "Uji Nyali" }
	for i, difficultyName in ipairs(difficultyNames) do
		local button = Instance.new("TextButton")
		button.Name = difficultyName
		button.Size = UDim2.fromOffset(94, 30)
		button.Position = UDim2.fromOffset((i - 1) * 98, 0)
		styleButton(button, difficultyName)
		button.Parent = difficultyContainer
		difficultyButtons[difficultyName] = button
	end

	local roomLabel = Instance.new("TextLabel")
	roomLabel.BackgroundTransparency = 1
	roomLabel.Position = UDim2.fromOffset(14, 182)
	roomLabel.Size = UDim2.fromOffset(390, 18)
	roomLabel.Text = "Rooms"
	roomLabel.TextXAlignment = Enum.TextXAlignment.Left
	roomLabel.Font = Enum.Font.GothamSemibold
	roomLabel.TextSize = 13
	roomLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
	roomLabel.Parent = panel

	local roomList = Instance.new("Frame")
	roomList.Name = "RoomList"
	roomList.Position = UDim2.fromOffset(14, 202)
	roomList.Size = UDim2.fromOffset(390, 192)
	roomList.BackgroundColor3 = Color3.fromRGB(30, 36, 47)
	roomList.BorderSizePixel = 0
	roomList.Parent = panel

	local roomListCorner = Instance.new("UICorner")
	roomListCorner.CornerRadius = UDim.new(0, 8)
	roomListCorner.Parent = roomList

	local roomRows = {}
	for i = 1, ROOM_ROW_COUNT do
		local row = Instance.new("TextButton")
		row.Name = "RoomRow" .. tostring(i)
		row.Size = UDim2.fromOffset(378, 17)
		row.Position = UDim2.fromOffset(6, 4 + (i - 1) * 18)
		row.BackgroundColor3 = Color3.fromRGB(43, 53, 69)
		row.BorderSizePixel = 0
		row.Font = Enum.Font.Gotham
		row.TextSize = 12
		row.TextColor3 = Color3.fromRGB(235, 240, 245)
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = string.format("Room %d | kosong", i)
		row.Parent = roomList

		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 6)
		rowCorner.Parent = row

		roomRows[i] = row
	end

	local refreshButton = Instance.new("TextButton")
	refreshButton.Name = "RefreshButton"
	refreshButton.Position = UDim2.fromOffset(14, 404)
	refreshButton.Size = UDim2.fromOffset(188, 38)
	styleButton(refreshButton, "Refresh")
	refreshButton.Parent = panel

	local queueButton = Instance.new("TextButton")
	queueButton.Name = "QueueButton"
	queueButton.Position = UDim2.fromOffset(216, 404)
	queueButton.Size = UDim2.fromOffset(188, 38)
	styleButton(queueButton, "Queue")
	queueButton.Parent = panel

	classicButton.Activated:Connect(function()
		self:RoomBrowserSelectMode("Classic")
		task.delay(0.15, function()
			if self._roomBrowser then
				self._roomBrowser:RequestSnapshot()
			end
		end)
	end)
	rankedButton.Activated:Connect(function()
		self:RoomBrowserSelectMode("Ranked")
		task.delay(0.15, function()
			if self._roomBrowser then
				self._roomBrowser:RequestSnapshot()
			end
		end)
	end)
	for difficultyName, button in pairs(difficultyButtons) do
		button.Activated:Connect(function()
			self:RoomBrowserSelectDifficulty(difficultyName)
			task.delay(0.15, function()
				if self._roomBrowser then
					self._roomBrowser:RequestSnapshot()
				end
			end)
		end)
	end
	for _, row in ipairs(roomRows) do
		row.Activated:Connect(function()
			local roomId = row:GetAttribute("RoomId")
			if roomId then
				self:RoomBrowserJoinRoom(roomId)
			end
		end)
	end
	refreshButton.Activated:Connect(function()
		if self._roomBrowser then
			self._roomBrowser:RequestSnapshot()
			self._roomBrowser:RequestRoomList()
		end
	end)
	queueButton.Activated:Connect(function()
		self:RoomBrowserQueueSelected()
	end)

	self._roomBrowserGui = gui
	self._roomBrowserWidgets = {
		Status = status,
		ClassicButton = classicButton,
		RankedButton = rankedButton,
		DifficultyLabel = difficultyLabel,
		DifficultyContainer = difficultyContainer,
		DifficultyButtons = difficultyButtons,
		Rows = roomRows,
		QueueButton = queueButton,
	}
end

function UISystem:_setButtonSelected(button, selected)
	if not button then
		return
	end
	if selected then
		button.BackgroundColor3 = Color3.fromRGB(88, 121, 173)
	else
		button.BackgroundColor3 = Color3.fromRGB(46, 57, 73)
	end
end

function UISystem:_refreshRoomBrowserView()
	if not self._roomBrowserWidgets then
		return
	end

	local state = self:GetRoomBrowserState() or {}
	local selectedMode = state.selectedMode or "Classic"
	local selectedDifficulty = state.selectedDifficulty or "Mudah"
	local rooms = state.rooms or {}
	local queueInfo = state.queue

	local statusText = string.format(
		"Mode: %s | Difficulty: %s | Rooms: %d",
		tostring(selectedMode),
		tostring(selectedDifficulty),
		#rooms
	)
	if state.lastError then
		statusText = statusText .. " | Error: " .. tostring(state.lastError)
	elseif queueInfo then
		statusText = statusText .. " | Queue: " .. tostring(queueInfo.queueType or queueInfo.mode or "started")
	end

	self._roomBrowserWidgets.Status.Text = statusText
	self:_setButtonSelected(self._roomBrowserWidgets.ClassicButton, selectedMode == "Classic")
	self:_setButtonSelected(self._roomBrowserWidgets.RankedButton, selectedMode == "Ranked")

	local showDifficulty = selectedMode ~= "Ranked"
	self._roomBrowserWidgets.DifficultyContainer.Visible = showDifficulty
	self._roomBrowserWidgets.DifficultyLabel.Visible = showDifficulty
	for difficultyName, button in pairs(self._roomBrowserWidgets.DifficultyButtons) do
		self:_setButtonSelected(button, selectedDifficulty == difficultyName)
	end

	for index, row in ipairs(self._roomBrowserWidgets.Rows) do
		local room = rooms[index]
		if room then
			local roomId = room.roomId or index
			local playerCount = room.playerCount or 0
			local maxPlayers = room.maxPlayers or 4
			local mode = room.mode or "Classic"
			local difficulty = room.difficulty or "-"
			row.Text = string.format(
				"Room %d | %s | %s | %d/%d",
				roomId,
				tostring(mode),
				tostring(difficulty),
				playerCount,
				maxPlayers
			)
			row:SetAttribute("RoomId", roomId)
			row.AutoButtonColor = true
		else
			row.Text = string.format("Room %d | kosong", index)
			row:SetAttribute("RoomId", nil)
			row.AutoButtonColor = false
		end
	end
end

function UISystem:_startRoomBrowserLoop()
	if self._roomBrowserLoopRunning then
		return
	end
	self._roomBrowserLoopRunning = true
	task.spawn(function()
		while self._roomBrowserLoopRunning do
			self:_refreshRoomBrowserView()
			task.wait(0.25)
		end
	end)
end

function UISystem:GetUIState(moduleName)
	return self._uiState[moduleName]
end

function UISystem:GetMatchResult()
	return self._matchResult
end

function UISystem:GetRoomBrowserState()
	if not self._roomBrowser then
		return nil
	end
	return self._roomBrowser:GetState()
end

function UISystem:RoomBrowserSelectMode(modeName)
	if self._roomBrowser then
		self._roomBrowser:SelectMode(modeName)
	end
end

function UISystem:RoomBrowserSelectDifficulty(difficultyName)
	if self._roomBrowser then
		self._roomBrowser:SelectDifficulty(difficultyName)
	end
end

function UISystem:RoomBrowserJoinRoom(roomId)
	if self._roomBrowser then
		self._roomBrowser:JoinRoom(roomId)
	end
end

function UISystem:RoomBrowserQueueSelected()
	if self._roomBrowser then
		self._roomBrowser:QueueSelected()
	end
end

return setmetatable({}, UISystem)
]]></ProtectedString>
