						<ProtectedString name="Source"><![CDATA[local LightInteraction = {}
LightInteraction.__index = LightInteraction

local function copy(value)
	local out = {}
	for k, v in pairs(value or {}) do
		out[k] = v
	end
	return out
end

function LightInteraction.new()
